#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int X, Y;
        cin >> X >> Y;
        int exp = Y * 30;
        if (X >= exp)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }
    return 0;
}
