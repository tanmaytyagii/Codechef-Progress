#include <bits/stdc++.h>
using namespace std;

int main() {
    int a, b, x, y;
    cin >> a >> b >> x >> y;
    int messi = 2 * a + b;
    int ronaldo = 2 * x + y;
    if (messi > ronaldo) {
        cout << "Messi" << endl;
    } else if (messi < ronaldo) {
        cout << "Ronaldo" << endl;
    } else {
        cout << "Equal" << endl;
    }
    return 0;
}
