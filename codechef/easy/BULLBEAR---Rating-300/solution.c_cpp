#include <bits/stdc++.h>
using namespace std;

int main() {
    int t, x, y;
    cin >> t;
    while (t--) {
        cin >> x >> y;
        if (x < y) {
            cout << "Profit" << endl;
        } else if (x > y) {
            cout << "Loss" << endl;
        } else {
            cout << "Neutral" << endl;
        }
    }
    return 0;
}
