#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string A, B;
        cin >> A >> B;
        int count1 = 0;
        int count2 = 0;
        for (int i = 0; i < n; i++) {
            if (A[i] == 'a') {
                count1++;
            }
        }
        for (int i = 0; i < n; i++) {
            if (B[i] == 'a') {
                count2++;
            }
        }
        if (count1 + count2 == n) {
            cout << "Yes" << endl;
        }
        else {
            cout << "No" << endl;
        }
    }

}