#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int> nums(2*n);
	    for(int i=0; i<2*n; i++){
	        cin>>nums[i];
	    }
	    int ans =0;
	    for(int i=0; i<n;i++){
	        ans = ans+ max(nums[i], nums[2*n-1-i]);
	    }
	    cout<<ans<<endl;
	}
}
