#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        vector < int > nums(n);
        for (int i = 0; i < n; i++) {
            cin >> nums[i];
        }
        int ptr1 = 0;
        int ptr2 = n - 1;
        while (k--) {
            if (nums[ptr1] > nums[ptr2]) {
                nums[ptr1] = 0;
                ptr1++;
                
            }
            else {
                nums[ptr2] = 0;
                ptr2--;
                
            }
        }
        int sum = 0;
        for (int i = 0; i < n; i++) {
            sum = sum + nums[i];
        }
        cout << sum << endl;
    }
}