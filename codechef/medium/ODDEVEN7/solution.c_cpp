#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int> nums(n);
	    for(int i=0; i<n; i++){
	        cin>>nums[i];
	    }
	    vector<int> odd;
	    vector<int> even;
	    for(int i=0; i<n; i++){
	        if(nums[i]%2==0){
	            even.push_back(nums[i]);
	        }
	        else{
	            odd.push_back(nums[i]);
	        }
	    }
	    int ans = min(odd.size(), even.size()) + 1;
	    cout<<ans<<endl;
	}

}
