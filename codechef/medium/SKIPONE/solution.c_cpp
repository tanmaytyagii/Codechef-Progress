#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        vector < int > nums(n);
        for (int i = 0; i < n; i++) {
            cin >> nums[i];
        }
        int sum = 0;
        int count = 1;
        for (int i = 0; i < n; i++) {
            if (sum <= k) {
                sum = sum + nums[i];
                count++;
            }
        }
        cout << count << endl;
    }

}