#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int count =0;
	    while(n%3!=0){
	        if((n+1)%3==0){
	            n = n+1;
	            count++;
	        }
	        else{
	            
	            int hehe= ((n/5)+1)*5;
	            if(hehe%3==0){
	                n = hehe;
	                count++;
	            }
	            else{
	                count = count+2;
	                break;
	            }
	            
	        }
	    }
	    cout<<count<<endl;
	}
}
