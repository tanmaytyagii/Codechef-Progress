#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int count =0;
	    while(n%3!=0){
	        if((n+1)%3==0){
	            n = n+1;
	            count++;
	        }
	        else if((n+2)%3==0){
	            count = count+2;
	            break;
	        }
	        else if((n+5)%3==0){
	            count++;
	            break;
	        }
	        else{
	            n= ((n/5)+1)*5;
	            count++;
	        }
	    }
	    cout<<count<<endl;
	}
}
