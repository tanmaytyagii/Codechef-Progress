#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    int count =0;
	    while(n%3==0){
	        if(n+1%3==0 || n+2%3==0|| n+3%3==0 || n+4%3==0){
	            n = n+1;
	            count++;
	        }
	        else{
	            n = n+5;
	            count++;
	        }
	    }
	    cout<<count<<endl;
	}

}
