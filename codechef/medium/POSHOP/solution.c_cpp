#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int> nums(n);
	    for(int i=0; i<n; i++){
	        cin>>nums[i];
	    }
	    int ans = *max_element(nums.begin(), nums.end());
	    for(int i=0; i<n; i++){
	        for(int j=i+1;j<n; j++){
	            if(nums[i]<=nums[j]){
	                ans = (max(ans, nums[i]+nums[j]);
	            }
	        }
	    }
	    cout<<ans<<endl;
	    
	}
	

}
